{
  "manifest_version": 3,
  "name": "Nous",
  "version": "1.0.0",
  "version_name": "1.6 + Reveal (desktop 1.0.0)",
  "description": "Inspect page resources, live HTML, previews and copyable URLs. Includes Video, font files and Reveal on page.",
  "minimum_chrome_version": "111",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Toggle Nous on this page",
    "default_popup": "launcher.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {"default": "Alt+Shift+N", "mac": "MacCtrl+Shift+N"}
    }
  }
}
